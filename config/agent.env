# ~/.config/crabbit/agent.env
# Loaded by the orchestrator each run. Copy to ~/.config/crabbit/agent.env.

# URL of the running crabbit-server
CRABBIT_API_URL="http://127.0.0.1:3000"

# Working directory for cloned repos and Claude scratch space
WORKDIR="${HOME}/.local/share/crabbit/work"

# Isolated Claude config dir — prevents personal hooks/settings from loading
# during agent runs (e.g. superpowers hooks that interfere with --print mode).
# The orchestrator writes the synced credentials here so Claude can auto-refresh.
CLAUDE_CONFIG_DIR="${HOME}/.local/share/crabbit/claude-config"
